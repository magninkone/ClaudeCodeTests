# Copy to .env and fill in your values. Never commit .env.

# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# --- Indeed (misceres/indeed-scraper) ---
# Actor: https://apify.com/misceres/indeed-scraper
# Pricing: $0.005/result
APIFY_INDEED_ACTOR_ID=misceres/indeed-scraper
APIFY_INDEED_MAX_RESULTS=25

# Country code for Indeed (US, GB, FR, DE, AU, CA, ...)
APIFY_COUNTRY=US

# --- LinkedIn (curious_coder/linkedin-jobs-scraper) ---
# Actor: https://apify.com/curious_coder/linkedin-jobs-scraper
# Pricing: $0.001/result. Actor scrapes until timeout — results are capped post-run.
APIFY_LINKEDIN_ACTOR_ID=curious_coder/linkedin-jobs-scraper
APIFY_LINKEDIN_MAX_RESULTS=50
APIFY_LINKEDIN_TIMEOUT_SECS=90

# --- Cost summary ---
# 25 Indeed ($0.125) + 50 LinkedIn ($0.05) = $0.175/unique search
# Free tier: $5/month → ~28 unique searches/month
