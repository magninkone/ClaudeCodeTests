# Copy to .env and fill in your values. Never commit .env.

# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify actor ID for job scraping (default: bebity/linkedin-jobs-scraper)
# Other options: orgupdate/linkedin-jobs-scraper, misceres/indeed-scraper
APIFY_ACTOR_ID=bebity/linkedin-jobs-scraper
