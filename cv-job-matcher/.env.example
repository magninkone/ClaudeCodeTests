# Copy to .env and fill in your values. Never commit .env.

# Apify API token — get yours at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify actor ID for job scraping (default: misceres/indeed-scraper)
# Other options: bebity/linkedin-jobs-scraper (paid), orgupdate/linkedin-jobs-scraper
APIFY_ACTOR_ID=misceres/indeed-scraper

# Country code for Indeed (used by misceres/indeed-scraper)
# Examples: US, GB, FR, DE, AU, CA
APIFY_COUNTRY=US
